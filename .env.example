# Copy to `.env` and edit. Every value here is read by gmail-automator at startup.

# --------------------------------------------------------------------- required
# 32 random bytes, base64 (urlsafe) encoded. Generate with:  gmail-automator gen-key
# Losing this makes every stored OAuth token unreadable; the accounts must be reconnected.
GMAIL_AUTOMATOR_TOKEN_ENCRYPTION_KEY=

# Google OAuth client from your own Cloud project. See docs/google-cloud-setup.md.
# Without these two, /v1/oauth/google/start returns a clear "not configured" error.
GMAIL_AUTOMATOR_GOOGLE_OAUTH_CLIENT_ID=
GMAIL_AUTOMATOR_GOOGLE_OAUTH_CLIENT_SECRET=
# Must match a redirect URI registered in the Google console, and the port must match how the
# gateway is actually reached.
GMAIL_AUTOMATOR_OAUTH_REDIRECT_URI=http://localhost:8000/v1/oauth/google/callback

# ------------------------------------------------------------------ deployment
GMAIL_AUTOMATOR_ENVIRONMENT=dev
# Loopback by default. In Docker this is overridden to 0.0.0.0 inside the container while the
# published port stays bound to 127.0.0.1.
GMAIL_AUTOMATOR_HOST=127.0.0.1
GMAIL_AUTOMATOR_PORT=8000
GMAIL_AUTOMATOR_DATABASE_URL=sqlite:///./data/gmail_automator.db
# Postgres alternative (requires the `postgres` extra):
#   GMAIL_AUTOMATOR_DATABASE_URL=postgresql+psycopg://gmail_automator:secret@localhost:5432/gmail_automator

# ------------------------------------------------------------------------ auth
# api_key (default) requires `Authorization: Bearer <key>` on every /v1 route and on /mcp.
# none is for loopback-only local use; the gateway logs a warning if the bind host is not loopback.
GMAIL_AUTOMATOR_AUTH_MODE=api_key
# Optional single admin key, useful before any key row exists. Shown nowhere but the env file.
GMAIL_AUTOMATOR_BOOTSTRAP_ADMIN_KEY=

# ---------------------------------------------------------------------- limits
# Gmail's published caps are ~500 messages/day (free) and 2,000 (Workspace), measured over a
# rolling 24 hour window. The gateway enforces `limit * GMAIL_AUTOMATOR_SOFT_LIMIT_RATIO` and refuses
# before calling Gmail, so an agent gets a clean error instead of a locked account.
GMAIL_AUTOMATOR_DEFAULT_DAILY_MESSAGE_LIMIT=500
GMAIL_AUTOMATOR_DEFAULT_DAILY_RECIPIENT_LIMIT=500
GMAIL_AUTOMATOR_SOFT_LIMIT_RATIO=0.85
# Pacing: one send per interval per account, persisted, so it survives restarts.
GMAIL_AUTOMATOR_DEFAULT_SEND_INTERVAL_SECONDS=2.0
GMAIL_AUTOMATOR_MAX_RECIPIENTS_PER_MESSAGE=500
GMAIL_AUTOMATOR_MAX_BODY_BYTES=1048576
GMAIL_AUTOMATOR_MAX_SCHEDULE_HORIZON_HOURS=24
GMAIL_AUTOMATOR_QUEUE_MAX_DEPTH=1000

# Where alembic.ini lives. Set this when the app is installed as a wheel or run from a container
# where the repository layout is not next to the package. Left unset, gmail-automator looks for
# `alembic.ini` inside the package and then in the repository root.
# GMAIL_AUTOMATOR_ALEMBIC_INI=/app/alembic.ini

# ---------------------------------------------------------------------- worker
GMAIL_AUTOMATOR_WORKER_ENABLED=true
GMAIL_AUTOMATOR_WORKER_POLL_INTERVAL_SECONDS=1.0
GMAIL_AUTOMATOR_WORKER_LEASE_SECONDS=120
# Give each worker a stable id when running more than one against the same database.
# GMAIL_AUTOMATOR_WORKER_ID=worker-1
GMAIL_AUTOMATOR_MAX_ATTEMPTS=5
GMAIL_AUTOMATOR_BACKOFF_BASE_SECONDS=1.0
GMAIL_AUTOMATOR_BACKOFF_MAX_SECONDS=64.0

# ------------------------------------------------------------------- retention
# Bodies are encrypted in the queue and wiped on a terminal state; these bound the rest.
GMAIL_AUTOMATOR_KEEP_SENT_PAYLOADS=false
GMAIL_AUTOMATOR_PAYLOAD_RETENTION_HOURS=24
GMAIL_AUTOMATOR_HISTORY_RETENTION_DAYS=30

# ------------------------------------------------------------------ attachments
# Off by default. When enabled, `path` attachments are additionally confined to
# GMAIL_AUTOMATOR_ATTACHMENT_ALLOWED_DIRS after symlink resolution.
GMAIL_AUTOMATOR_ATTACHMENTS_ENABLED=false
GMAIL_AUTOMATOR_ATTACHMENT_MAX_BYTES=10485760
GMAIL_AUTOMATOR_ATTACHMENT_ALLOWED_DIRS=

# ------------------------------------------------------------------- observability
GMAIL_AUTOMATOR_LOG_LEVEL=INFO
GMAIL_AUTOMATOR_LOG_JSON=true
GMAIL_AUTOMATOR_METRICS_ENABLED=true

# ------------------------------------------------------------------------- mcp
# Where the Streamable HTTP MCP endpoint is served. `gmail-automator mcp-stdio` ignores this.
GMAIL_AUTOMATOR_MCP_MOUNT_PATH=/mcp

# ------------------------------------------------- service account (Workspace)
# Optional. With a Workspace admin's domain-wide delegation grant, gmail-automator can send as a mailbox
# unattended: no browser consent, and no refresh token stored at all. Both values are required
# together; half-configured is treated as not configured. See
# docs/google-cloud-setup.md#service-accounts-workspace-only
# GMAIL_AUTOMATOR_SERVICE_ACCOUNT_KEY_FILE=/run/secrets/gmail_automator-service-account.json
# GMAIL_AUTOMATOR_SERVICE_ACCOUNT_SUBJECT=agent@acme.co
# Only gmail.send is ever requested - the admin grant bounds everything else.
# Comma-separated, like GMAIL_AUTOMATOR_OAUTH_SCOPES. Defaults to gmail.send alone.
# GMAIL_AUTOMATOR_SERVICE_ACCOUNT_SCOPES=https://www.googleapis.com/auth/gmail.send

# ----------------------------------------------------------------------- oauth
# Defaults target Google. Point these at a fake provider for offline tests.
# GMAIL_AUTOMATOR_OAUTH_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
# GMAIL_AUTOMATOR_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
# GMAIL_AUTOMATOR_OIDC_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# Least privilege by default: send only. The read, reply, and label tools refuse with
# scope_missing until you widen this and reconnect the account.
#   read only:  .../auth/gmail.readonly
#   read + reply + organise: .../auth/gmail.modify  (also grants reading message bodies)
# GMAIL_AUTOMATOR_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send,openid,email
# GMAIL_AUTOMATOR_OAUTH_STATE_TTL_SECONDS=600
# GMAIL_AUTOMATOR_TOKEN_REFRESH_LEEWAY_SECONDS=60
