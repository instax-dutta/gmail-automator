# Copy to `.env` and edit. Every value here is read by Fmaiily at startup.

# --------------------------------------------------------------------- required
# 32 random bytes, base64 (urlsafe) encoded. Generate with:  fmaiily gen-key
# Losing this makes every stored OAuth token unreadable; the accounts must be reconnected.
FMAIILY_TOKEN_ENCRYPTION_KEY=

# Google OAuth client from your own Cloud project. See docs/google-cloud-setup.md.
# Without these two, /v1/oauth/google/start returns a clear "not configured" error.
FMAIILY_GOOGLE_OAUTH_CLIENT_ID=
FMAIILY_GOOGLE_OAUTH_CLIENT_SECRET=
# Must match a redirect URI registered in the Google console, and the port must match how the
# gateway is actually reached.
FMAIILY_OAUTH_REDIRECT_URI=http://localhost:8000/v1/oauth/google/callback

# ------------------------------------------------------------------ deployment
FMAIILY_ENVIRONMENT=dev
# Loopback by default. In Docker this is overridden to 0.0.0.0 inside the container while the
# published port stays bound to 127.0.0.1.
FMAIILY_HOST=127.0.0.1
FMAIILY_PORT=8000
FMAIILY_DATABASE_URL=sqlite:///./data/fmaiily.db
# Postgres alternative (requires the `postgres` extra):
#   FMAIILY_DATABASE_URL=postgresql+psycopg://fmaiily:secret@localhost:5432/fmaiily

# ------------------------------------------------------------------------ auth
# api_key (default) requires `Authorization: Bearer <key>` on every /v1 route and on /mcp.
# none is for loopback-only local use; the gateway logs a warning if the bind host is not loopback.
FMAIILY_AUTH_MODE=api_key
# Optional single admin key, useful before any key row exists. Shown nowhere but the env file.
FMAIILY_BOOTSTRAP_ADMIN_KEY=

# ---------------------------------------------------------------------- limits
# Gmail's published caps are ~500 messages/day (free) and 2,000 (Workspace), measured over a
# rolling 24 hour window. The gateway enforces `limit * FMAIILY_SOFT_LIMIT_RATIO` and refuses
# before calling Gmail, so an agent gets a clean error instead of a locked account.
FMAIILY_DEFAULT_DAILY_MESSAGE_LIMIT=500
FMAIILY_DEFAULT_DAILY_RECIPIENT_LIMIT=500
FMAIILY_SOFT_LIMIT_RATIO=0.85
# Pacing: one send per interval per account, persisted, so it survives restarts.
FMAIILY_DEFAULT_SEND_INTERVAL_SECONDS=2.0
FMAIILY_MAX_RECIPIENTS_PER_MESSAGE=500
FMAIILY_MAX_BODY_BYTES=1048576
FMAIILY_MAX_SCHEDULE_HORIZON_HOURS=24
FMAIILY_QUEUE_MAX_DEPTH=1000

# Where alembic.ini lives. Set this when the app is installed as a wheel or run from a container
# where the repository layout is not next to the package. Left unset, Fmaiily looks for
# `alembic.ini` inside the package and then in the repository root.
# FMAIILY_ALEMBIC_INI=/app/alembic.ini

# ---------------------------------------------------------------------- worker
FMAIILY_WORKER_ENABLED=true
FMAIILY_WORKER_POLL_INTERVAL_SECONDS=1.0
FMAIILY_WORKER_LEASE_SECONDS=120
# Give each worker a stable id when running more than one against the same database.
# FMAIILY_WORKER_ID=worker-1
FMAIILY_MAX_ATTEMPTS=5
FMAIILY_BACKOFF_BASE_SECONDS=1.0
FMAIILY_BACKOFF_MAX_SECONDS=64.0

# ------------------------------------------------------------------- retention
# Bodies are encrypted in the queue and wiped on a terminal state; these bound the rest.
FMAIILY_KEEP_SENT_PAYLOADS=false
FMAIILY_PAYLOAD_RETENTION_HOURS=24
FMAIILY_HISTORY_RETENTION_DAYS=30

# ------------------------------------------------------------------ attachments
# Off by default. When enabled, `path` attachments are additionally confined to
# FMAIILY_ATTACHMENT_ALLOWED_DIRS after symlink resolution.
FMAIILY_ATTACHMENTS_ENABLED=false
FMAIILY_ATTACHMENT_MAX_BYTES=10485760
FMAIILY_ATTACHMENT_ALLOWED_DIRS=

# ------------------------------------------------------------------- observability
FMAIILY_LOG_LEVEL=INFO
FMAIILY_LOG_JSON=true
FMAIILY_METRICS_ENABLED=true

# ------------------------------------------------------------------------- mcp
# Where the Streamable HTTP MCP endpoint is served. `fmaiily mcp-stdio` ignores this.
FMAIILY_MCP_MOUNT_PATH=/mcp

# ----------------------------------------------------------------------- oauth
# Defaults target Google. Point these at a fake provider for offline tests.
# FMAIILY_OAUTH_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
# FMAIILY_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
# FMAIILY_OIDC_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# FMAIILY_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send,openid,email
# FMAIILY_OAUTH_STATE_TTL_SECONDS=600
# FMAIILY_TOKEN_REFRESH_LEEWAY_SECONDS=60
